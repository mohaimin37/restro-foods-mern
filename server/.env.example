NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (ask the user for the password when setting this up)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/restro-foods?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_DAYS=30

# Frontend URL (for CORS + Stripe redirect)
CLIENT_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
